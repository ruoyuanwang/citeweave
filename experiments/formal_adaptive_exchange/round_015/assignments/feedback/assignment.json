  "packet_kind": "feedback",
  "result_schema": {
    "$defs": {
      "HumanProxyEdit": {
        "additionalProperties": false,
        "description": "One local edit available to a person reviewing the visible artifact.\n\nThe proxy cannot replace an entire report.  It may only operate on an exact\nvisible span or append a short caveat, matching the controls exposed by the\nexperimental review interface.",
        "properties": {
          "action": {
            "enum": [
              "replace_span",
              "delete_span",
              "append_caveat"
            ],
            "title": "Action",
            "type": "string"
          },
          "replacement_text": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Replacement Text"
          },
          "target_text": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Target Text"
          }
        },
        "required": [
          "action"
        ],
        "title": "HumanProxyEdit",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "confidence": {
        "maximum": 1.0,
        "minimum": 0.0,
        "title": "Confidence",
        "type": "number"
      },
      "decision": {
        "enum": [
          "accept",
          "revise",
          "reject"
        ],
        "title": "Decision",
        "type": "string"
      },
      "evidence_ids": {
        "items": {
          "type": "string"
        },
        "title": "Evidence Ids",
        "type": "array"
      },
      "judge_id": {
        "const": "feedback",
        "default": "feedback",
        "title": "Judge Id",
        "type": "string"
      },
      "packet_id": {
        "pattern": "^FP[0-9a-f]{20}$",
        "title": "Packet Id",
        "type": "string"
      },
      "reason": {
        "minLength": 1,
        "title": "Reason",
        "type": "string"
      },
      "suggested_revision": {
        "anyOf": [
          {
            "$ref": "#/$defs/HumanProxyEdit"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      }
    },
    "required": [
      "packet_id",
      "decision",
      "confidence",
      "reason"
    ],
    "title": "FeedbackResult",
    "type": "object"
  },
